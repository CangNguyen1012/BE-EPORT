generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Language {
  id           String   @id @default(uuid())
  languageCode String   @unique
  languageName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Country {
  id          String   @id @default(uuid())
  countryCode String   @unique
  countryName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomerType {
  id               String   @id @default(uuid())
  customerTypeCode String   @unique
  customerTypeName String   @unique
  userGroupRank    Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model JobMode {
  id               String   @id @default(uuid())
  jobModeCode      String
  jobModeName      String
  isLoLo           Boolean  @default(false)
  isCfsStuff       Boolean  @default(false)
  isCfsUnstuff     Boolean  @default(false)
  isCfsChange      Boolean  @default(false)
  isServiceYard    Boolean  @default(false)
  isServiceNoncont Boolean  @default(false)
  extraMode        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SizeContainer {
  id                 String   @id @default(uuid())
  operationCode      String
  localSizeType      String
  isoSizeType        String
  cargoTypeCode      String
  emptyCargoTypeCode String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Refer {
  id            String   @id @default(uuid())
  operationCode String   @db.VarChar(255)
  refName       String?  @db.VarChar(255)
  applyDate     DateTime
  expireDate    DateTime
  rounding      String   @db.VarChar(255)
  moneyCredit   String   @db.VarChar(255)
  hourAdding    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Commodity {
  id            String   @id @default(uuid())
  commodityCode String   @db.VarChar(255)
  commodityName String   @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Job {
  id        String   @id @default(uuid())
  jobCode   String   @unique @db.VarChar(10)
  jobName   String   @unique @db.VarChar(255)
  isQuay    Boolean  @default(false) @db.Boolean
  isYard    Boolean  @default(false) @db.Boolean
  isGate    Boolean  @default(false) @db.Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Port {
  id       String @id @default(uuid())
  portCode String @db.VarChar(10)
  portName String @db.VarChar(50)
}

model Operation {
  id             String  @id @default(uuid())
  operationCode  String  @db.VarChar(10) @unique
  operationName  String  @db.VarChar(255)
  isEdo          Boolean @default(false) @db.Boolean
  isActive       Boolean @default(false) @db.Boolean
  edoNote        Boolean @default(false) @db.Boolean
  isLocalForeign String? @db.VarChar(10)
  moneyCredit    String? @db.VarChar(10)
}
