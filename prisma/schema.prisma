generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  name     String
  password String
}

model Language {
  id           String @id @default(uuid())
  languageCode String @unique
  languageName String
}

model Country {
  id          String @id @default(uuid())
  countryCode String @unique
  countryName String
}

model CustomerType {
  id               String @id @default(uuid())
  customerTypeCode String @unique
  customerTypeName String @unique
  userGroupRank    Int
}